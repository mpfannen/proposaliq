# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Supabase) ──────────────────────────────
# Get these from: Supabase → Project Settings → Database → Connection Parameters
DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password

# ── Auth ─────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# ── AI ───────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS (production only) ───────────────────────────
# Set to your frontend URL once deployed (e.g. https://proposaliq.vercel.app)
FRONTEND_URL=http://localhost:3000
